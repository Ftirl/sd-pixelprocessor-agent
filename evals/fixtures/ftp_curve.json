      "void FTP_Native(FTP_Curve c, float s, out vec4 X, out vec4 dX) {",
      "    X = c.c0 + s*(c.c1 + s*(c.c2 + s*c.c3));",
      "    dX = c.c1 + s*(2.0*c.c2 + 3.0*s*c.c3);",
      "}"
